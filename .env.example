# ============================================================
# Template de configuration — copier vers .env et remplir.
# Le fichier .env est ignoré par Git. NE JAMAIS commiter de vraies valeurs.
# ============================================================

# --- Blockchain (Polygon Amoy testnet) ---
AMOY_RPC_URL=https://polygon-amoy.drpc.org
# Clé privée de l'OWNER, utilisée seulement pour déployer/gérer les reporters.
# Ne jamais la donner à n8n.
OWNER_PRIVATE_KEY=
# Clé privée du compte REPORTER uniquement (jamais celle de l'Owner)
REPORTER_PRIVATE_KEY=
# Adresse publique du contrat PhishingRegistry déployé sur Amoy
REGISTRY_CONTRACT_ADDRESS=0x8d51dB4a92c338075360A17AcA005ec282fE1f23
# Bloc de déploiement public : limite l'historique d'events consulté par listen/check
REGISTRY_DEPLOYMENT_BLOCK=43090902
# Clé API Polygonscan (pour la vérification du contrat)
POLYGONSCAN_API_KEY=

# --- LLM ---
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
# Utiliser les alias -latest (les modèles épinglés 2.0 ont des quotas séparés souvent épuisés)
GEMINI_MODEL_PRIMARY=gemini-flash-latest
GEMINI_MODEL_LITE=gemini-flash-lite-latest
NVIDIA_MODEL_FALLBACK=meta/llama-3.1-8b-instruct

# --- Alertes ---
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_MANUAL_REVIEW=

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
