# ============================================================
# Template — copier vers n8n/.env et remplir. n8n/.env est ignoré par Git.
# Docker Compose charge automatiquement ce fichier car il est à côté de
# docker-compose.yml : un `docker compose up -d` nu (sans --env-file)
# fonctionne (RNF-4).
# ============================================================

# Générée une seule fois (voir n8n/README.md) puis jamais régénérée :
# régénérer cette clé rend illisibles tous les credentials déjà enregistrés dans n8n.
N8N_ENCRYPTION_KEY=

# Secret partagé entre n8n et le bridge blockchain interne WF3 (32 caractères
# minimum). Générer une valeur aléatoire distincte de N8N_ENCRYPTION_KEY.
CHAIN_BRIDGE_TOKEN=

# Secret aleatoire partage entre n8n et le bridge de lecture/journal WF1/WF2
# (32 caracteres minimum, distinct de CHAIN_BRIDGE_TOKEN). Generation :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SHARED_SECRET=

# Configuration publique lue par le bridge blockchain WF3 et le bridge WF1/WF2.
AMOY_RPC_URL=https://polygon-amoy.drpc.org
REGISTRY_CONTRACT_ADDRESS=0x8d51dB4a92c338075360A17AcA005ec282fE1f23
REGISTRY_DEPLOYMENT_BLOCK=43090902

# Clé du compte Reporter uniquement (WF3). Ne jamais placer OWNER_PRIVATE_KEY ici.
REPORTER_PRIVATE_KEY=

# WF2 - analyse IA. Ces cles restent uniquement dans le service analysis.
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-flash-lite-latest
NVIDIA_API_KEY=
NVIDIA_MODEL_FALLBACK=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
