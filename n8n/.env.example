# ============================================================
# Template — copier vers n8n/.env et remplir. n8n/.env est ignoré par Git.
# Docker Compose charge automatiquement ce fichier car il est à côté de
# docker-compose.yml : un `docker compose up -d` nu (sans --env-file)
# fonctionne (RNF-4).
# ============================================================

# Générée une seule fois (voir n8n/README.md) puis jamais régénérée :
# régénérer cette clé rend illisibles tous les credentials déjà enregistrés dans n8n.
N8N_ENCRYPTION_KEY=

# Secret partagé entre n8n et le bridge blockchain interne (32 caractères
# minimum). Générer une valeur aléatoire distincte de N8N_ENCRYPTION_KEY.
CHAIN_BRIDGE_TOKEN=

# Configuration publique lue uniquement par le bridge blockchain.
AMOY_RPC_URL=https://polygon-amoy.drpc.org
REGISTRY_CONTRACT_ADDRESS=0x8d51dB4a92c338075360A17AcA005ec282fE1f23
REGISTRY_DEPLOYMENT_BLOCK=43090902

# Clé du compte Reporter uniquement. Ne jamais placer OWNER_PRIVATE_KEY ici.
REPORTER_PRIVATE_KEY=
