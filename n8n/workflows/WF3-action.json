{
  "id": "anti-phishing-wf3-action",
  "name": "WF3 - Blockchain and Discord Action",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "wf3-execute-workflow-trigger",
      "name": "When Called by WF2",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [-900, 0],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "wf3-execute-secured-action",
      "name": "Execute Secured WF3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-660, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAIN_BRIDGE_URL + '/internal/wf3/execute' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ reportId: $json.reportId, type: $json.type, value: $json.value, verdict: $json.verdict, category: $json.category, scoreFinal: $json.scoreFinal, indicators: $json.indicators, executionId: 'n8n-' + $execution.id }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 900000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CHAIN_BRIDGE_CREDENTIAL_ID",
          "name": "Chain Bridge Header Auth"
        }
      }
    },
    {
      "id": "wf3-merge-execution-context",
      "name": "Merge Execution Context",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [-540, 0],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2,
        "options": {
          "clashHandling": {
            "values": {
              "resolveClash": "preferInput2",
              "mergeMode": "deepMerge",
              "overrideEmpty": false
            }
          }
        }
      }
    },
    {
      "id": "wf3-final-alert-required",
      "name": "Final Alert Required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-420, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "wf3-alert-required-condition",
              "leftValue": "={{ $json.alertRequired }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wf3-claim-final-alert",
      "name": "Claim Final Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, -100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAIN_BRIDGE_URL + '/internal/wf3/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ context: { reportId: $json.reportId, type: $json.type, value: $json.value, verdict: $json.verdict, category: $json.category, scoreFinal: $json.scoreFinal, indicators: $json.indicators }, claimId: 'n8n-' + $execution.id }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CHAIN_BRIDGE_CREDENTIAL_ID",
          "name": "Chain Bridge Header Auth"
        }
      }
    },
    {
      "id": "wf3-dispatch-authorized",
      "name": "Dispatch Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [60, -100],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "wf3-dispatch-authorized-condition",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wf3-alerts-channel",
      "name": "Alerts Channel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [300, -100],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "wf3-alerts-channel-condition",
              "leftValue": "={{ $json.channel }}",
              "rightValue": "alerts",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wf3-send-alerts-discord",
      "name": "Send Alerts Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [540, -200],
      "parameters": {
        "authentication": "webhook",
        "operation": "sendLegacy",
        "content": "={{ $json.discord.content }}",
        "options": {
          "username": "={{ $json.discord.username }}",
          "wait": true
        },
        "embeds": {
          "values": [
            {
              "inputMethod": "json",
              "json": "={{ JSON.stringify($json.discord.embeds[0]) }}"
            }
          ]
        }
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_DISCORD_ALERTS_CREDENTIAL_ID",
          "name": "Discord Alerts Webhook"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "wf3-send-manual-discord",
      "name": "Send Manual Review Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [540, 0],
      "parameters": {
        "authentication": "webhook",
        "operation": "sendLegacy",
        "content": "={{ $json.discord.content }}",
        "options": {
          "username": "={{ $json.discord.username }}",
          "wait": true
        },
        "embeds": {
          "values": [
            {
              "inputMethod": "json",
              "json": "={{ JSON.stringify($json.discord.embeds[0]) }}"
            }
          ]
        }
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_DISCORD_MANUAL_REVIEW_CREDENTIAL_ID",
          "name": "Discord Manual Review Webhook"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "wf3-classify-discord-outcome",
      "name": "Classify Discord Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, -100],
      "parameters": {
        "jsCode": "const acknowledged = typeof $json.id === 'string' && /^[0-9]{17,20}$/.test($json.id) && $json.error === undefined;\nreturn [{ json: { outcome: acknowledged ? 'sent' : 'uncertain' } }];"
      }
    },
    {
      "id": "wf3-merge-claim-outcome",
      "name": "Merge Claim and Outcome",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [900, -100],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2,
        "options": {
          "clashHandling": {
            "values": {
              "resolveClash": "preferInput2",
              "mergeMode": "deepMerge",
              "overrideEmpty": false
            }
          }
        }
      }
    },
    {
      "id": "wf3-settle-final-alert",
      "name": "Settle Final Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, -100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAIN_BRIDGE_URL + '/internal/wf3/settle' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ reportId: $json.reportId, claim: $json.claim, outcome: $json.outcome }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CHAIN_BRIDGE_CREDENTIAL_ID",
          "name": "Chain Bridge Header Auth"
        }
      }
    }
  ],
  "connections": {
    "When Called by WF2": {
      "main": [
        [
          {
            "node": "Execute Secured WF3",
            "type": "main",
            "index": 0
          },
          {
            "node": "Merge Execution Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Secured WF3": {
      "main": [
        [
          {
            "node": "Merge Execution Context",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Execution Context": {
      "main": [
        [
          {
            "node": "Final Alert Required?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Final Alert Required?": {
      "main": [
        [
          {
            "node": "Claim Final Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Claim Final Alert": {
      "main": [
        [
          {
            "node": "Dispatch Authorized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Authorized?": {
      "main": [
        [
          {
            "node": "Alerts Channel?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Merge Claim and Outcome",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Alerts Channel?": {
      "main": [
        [
          {
            "node": "Send Alerts Discord",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Manual Review Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Alerts Discord": {
      "main": [
        [
          {
            "node": "Classify Discord Outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Manual Review Discord": {
      "main": [
        [
          {
            "node": "Classify Discord Outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Discord Outcome": {
      "main": [
        [
          {
            "node": "Merge Claim and Outcome",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Claim and Outcome": {
      "main": [
        [
          {
            "node": "Settle Final Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
