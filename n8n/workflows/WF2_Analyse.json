        "jsCode": "const request = $json;\nconst body = request.body;\nif (!body || typeof body !== 'object') throw new Error('Corps WF2 invalide');\nconst allowed = new Set(['reportId','type','value']);\nif (Object.keys(body).some((key) => !allowed.has(key))) throw new Error('Champs WF2 inattendus');\nif (!/^r_\\d{8}T\\d{6}Z_[A-Za-z0-9_-]{1,64}$/.test(body.reportId)) throw new Error('reportId WF2 invalide');\nif (body.type !== 'url' && body.type !== 'wallet') throw new Error('type WF2 invalide');\nif (typeof body.value !== 'string' || !body.value || body.value.length > 2048) throw new Error('value WF2 invalide');\nreturn [{ json: body }];"
