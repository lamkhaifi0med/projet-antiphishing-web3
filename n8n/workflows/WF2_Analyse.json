    {
      "parameters": {
        "jsCode": "// Traduit l'erreur technique en explication comprehensible : le\n// relecteur Discord doit comprendre pourquoi l'analyse a echoue sans\n// lire du jargon HTTP/TLS.\nconst record = $json.record || $json;\nconst raw = String(record.error || '');\n\nfunction explain(text) {\n  if (/certificate|altnames|cert/i.test(text))\n    return \"Le site presente un certificat de securite invalide ou usurpe. Impossible de verifier son identite - c'est en soi un signal suspect.\";\n  if (/ENOTFOUND|EAI_AGAIN|getaddrinfo|dns/i.test(text))\n    return \"Le domaine n'existe plus ou ne repond pas (site probablement deja demantele).\";\n  if (/timeout|ETIMEDOUT|ESOCKETTIMEDOUT/i.test(text))\n    return \"Le site n'a pas repondu dans le delai imparti (hors ligne ou tres lent).\";\n  if (/ECONNREFUSED|ECONNRESET/i.test(text))\n    return \"Le serveur du site a refuse ou coupe la connexion.\";\n  if (/blocked|ssrf|private|forbidden_target/i.test(text))\n    return \"L'adresse cible est interdite d'analyse (adresse interne ou protegee).\";\n  if (/521|522|523/.test(text))\n    return \"Le site est derriere Cloudflare mais son serveur d'origine est hors ligne (probablement demantele).\";\n  if (/content-type non-HTML|unusable_response/i.test(text))\n    return \"Le site n'a pas renvoye de page web analysable (contenu vide ou non-HTML).\";\n  if (/provider_error|429|quota/i.test(text))\n    return \"Le service d'analyse IA etait temporairement surcharge. Soumettez a nouveau ce signalement.\";\n  return \"L'analyse automatique n'a pas abouti pour une raison technique.\";\n}\n\nreturn [{ json: {\n  reportId: $('Valider WF2').first().json.reportId,\n  valueDefanged: record.valueDefanged || 'indisponible',\n  friendlyReason: explain(raw),\n  technicalDetail: raw.slice(0, 160),\n} }];"
      },
