    {
      "parameters": {
        "jsCode": "const allowedStatuses = new Set(['analyzing', 'manual_review', 'reported', 'already_blacklisted', 'failed']);\nconst status = $json.status;\nconst txHash = typeof $json.txHash === 'string' && /^0x[0-9a-fA-F]{64}$/.test($json.txHash) ? $json.txHash : null;\nconst requiresConfirmedTx = status === 'reported' || status === 'already_blacklisted';\nconst safeError = typeof $json.error === 'string' && /^[A-Z][A-Z0-9_]{0,99}$/.test($json.error) ? $json.error : null;\nconst valid = allowedStatuses.has(status) && (!requiresConfirmedTx || txHash !== null);\nreturn [{ json: {\n  status: valid ? status : 'failed',\n  txHash: valid ? txHash : null,\n  error: valid ? safeError : 'WF3_INVALID_RESULT'\n} }];"
      },
