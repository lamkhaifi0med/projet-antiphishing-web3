    {
      "parameters": {
        "jsCode": "const source = $('Valider WF2').first().json;\nconst analysis = source.type === 'wallet' ? $('Wallet en revue').first().json : $('Preparer resultat').first().json;\nconst indicators = (Array.isArray(analysis.indicators) ? analysis.indicators : [])\n  .filter((item) => typeof item === 'string' && item.length > 0)\n  .map((item) => item.replace(/[\\u0000-\\u001f\\u007f]/g, ' ').slice(0, 200))\n  .filter(Boolean)\n  .slice(0, 5);\nreturn [{ json: {\n  reportId: source.reportId,\n  type: source.type,\n  value: source.value,\n  verdict: analysis.verdict,\n  category: analysis.verdict === 'malicious' ? analysis.category : null,\n  scoreFinal: analysis.scoreFinal,\n  indicators,\n  llmConfidence: typeof analysis.llmConfidence === 'number' ? analysis.llmConfidence : null,\n  featureScore: typeof analysis.featureScore === 'number' ? analysis.featureScore : null\n} }];"
      },
